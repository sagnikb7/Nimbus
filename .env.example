# The active weather provider is now a CLIENT setting (localStorage, default
# open-meteo) — not an env var. The server just needs each provider's key.
#
# WeatherAPI.com key (only needed to enable the "weatherapi" provider; Open-Meteo
# is keyless). Legacy name WEATHER_API_KEY is still read as a fallback.
WEATHERAPI_KEY=your_api_key_here
PORT=3033
