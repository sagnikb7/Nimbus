{
  "name": "node-weather",
  "version": "1.6.0",
  "description": "A weather app powered by WeatherAPI",
  "main": "server/index.js",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "weather",
    "node",
    "express",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1",
    "supertest": "^7.2.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.1"
  }
}
